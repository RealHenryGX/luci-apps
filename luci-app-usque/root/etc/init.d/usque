#!/bin/sh /etc/rc.common

USE_PROCD=1
START=70
STOP=05

run_one() {
	local mode="$1" bind="$2" port="$3" sni="$4"

	procd_open_instance "$mode"
	procd_set_param command /usr/bin/usque "$mode" \
		-c /etc/usque/config.json \
		-b "$bind" -p "$port"

	# l4-http-proxy resolves names locally (used by tailscaled's HTTPS_PROXY and DoH)
	# full socks mode lets DNS go through the tunnel, avoiding local poisoning
	if [ "$mode" = "l4-http-proxy" ]; then
		procd_append_param command --system-dns
	fi
	[ -n "$sni" ] && procd_append_param command -s "$sni"

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	local bind hport fport sni

	config_load usque
	config_get bind  main bind            "127.0.0.1"
	config_get hport main http_port       "7902"
	config_get fport main socks_full_port "7903"
	config_get sni   main sni             ""

	[ -f /etc/usque/config.json ] || {
		logger -t usque "missing /etc/usque/config.json (usque register -a -c /etc/usque/config.json)"
		return 1
	}

	[ -n "$hport" ] && run_one l4-http-proxy "$bind" "$hport" "$sni"
	[ -n "$fport" ] && run_one socks         "$bind" "$fport" "$sni"
}

service_triggers() {
	procd_add_reload_trigger usque
}
